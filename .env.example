# Copy to .env and fill in before going live.
#
# The intake form POSTs a JSON body to this URL when set.
# The endpoint MUST be HTTPS and operated by a HIPAA-covered service.
# This value is embedded in the client bundle - never put a secret here.
VITE_INTAKE_ENDPOINT=

# Canonical origin used for <link rel="canonical">, the Open Graph url, the
# sitemap and robots.txt. Defaults to the practice's production URL when unset.
#
# On Vercel this is resolved automatically from the deployment's own domain, so
# you normally do not need to set it. Set it on other preview/staging hosts,
# otherwise the canonical tags would tell search engines that the preview is a
# duplicate of production.
VITE_SITE_URL=

# Deploy base path, always with a leading and trailing slash. Leave unset for a
# root deploy (production / custom domain / Vercel). Set it only when the site
# is served from a subpath, e.g. a project site on a static host:
#   VITE_BASE=/my-repo/
VITE_BASE=
